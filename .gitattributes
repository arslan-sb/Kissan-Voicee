# Normalise everything to LF in the repo; Windows checkouts are handled per-type below.
* text=auto eol=lf

# Must be LF - executed inside Linux containers / by sh
*.sh            text eol=lf
mvnw            text eol=lf
*.sql           text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
Dockerfile      text eol=lf
.env*           text eol=lf

# Must be CRLF - executed by Windows
*.cmd           text eol=crlf
*.bat           text eol=crlf
*.ps1           text eol=crlf

# Never touch
*.jar           binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.webm binary
*.mp3 binary
*.wav binary
*.xlsx binary
*.pdf  binary
*.zip  binary

# Keep generated/vendored files out of diffs and language stats
docs/**         linguist-documentation
